# ═══ base de données (service `postgres` de compose.yaml) ═══════════════════════════════════════════
#
# OÙ POSER LE VRAI FICHIER : /opt/okxq/env/postgres.env sur le serveur (chmod 600), hors du dépôt —
# c'est le nom utilisé par deploy/install.sh, qui génère le mot de passe une fois et ne l'imprime
# jamais. compose.yaml accepte aussi /opt/okxq/env/db.env, pour qui préfère nommer le fichier d'après
# le rôle plutôt que d'après le moteur ; les deux sont optionnels et lus dans cet ordre.
#
# CE SERVICE NE REÇOIT AUCUNE CLÉ OKX NI TYPESAFE : il stocke des données, il n'appelle aucun
# fournisseur. Il n'est attaché qu'au réseau interne de compose et n'a donc aucune route vers Internet.
# Le port n'est publié que sur 127.0.0.1, pour les tests d'intégration locaux (§62 : PostgreSQL n'est
# pas exposé publiquement).

POSTGRES_USER=okxq
POSTGRES_DB=okxq_paper
# Valeur manifestement factice. Sur le serveur : `openssl rand -hex 24`, posé une seule fois. Ce mot de
# passe doit apparaître dans ce fichier ET dans les DATABASE_URL des services qui lisent la base — et
# nulle part ailleurs (jamais dans une image, un journal, un commit ou une sauvegarde non chiffrée).
POSTGRES_PASSWORD=remplacer-par-le-mot-de-passe-genere-hors-git

# Sauvegardes (§62) : infra/backup.sh chiffre le vidage si une phrase de passe est fournie. Elle ne se
# stocke PAS à côté des sauvegardes — sinon le chiffrement ne protège de rien.
OKXQ_BACKUP_PASSPHRASE=remplacer-par-la-phrase-de-passe-de-sauvegarde-hors-git
