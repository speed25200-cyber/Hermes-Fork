# ═══ collector — données PUBLIQUES uniquement ═══════════════════════════════════════════════════════
#
# OÙ POSER LE VRAI FICHIER : /opt/okxq/env/collector.env sur le serveur (chmod 600, propriétaire root),
# hors du dépôt. deploy/install.sh le crée et le remplit ; ce fichier-ci n'est qu'un modèle versionné.
# Ne JAMAIS renommer un *.env.example en *.env dans le dépôt : scripts/security_check.py le refuse.
#
# CE SERVICE NE REÇOIT AUCUNE CLÉ OKX. Il n'en a pas besoin : le carnet, les trades et les métadonnées
# d'instruments sont publics. Lui en donner une élargirait sans contrepartie le rayon d'un vol de clé
# (§60). Si une valeur OKX_API_* apparaît ici un jour, c'est une régression de sécurité, pas une
# configuration.

# Base de données (journal durable). Le mot de passe est généré par l'installateur ; la valeur ci-dessous
# est manifestement fausse et ne doit jamais être déployée telle quelle.
DATABASE_URL=postgresql+psycopg://okxq:remplacer-par-le-mot-de-passe-genere-hors-git@postgres:5432/okxq_paper

# Mode affiché par deploy/etat.sh. Purement informatif : le mode réel vient du profil YAML validé.
OKXQ_MODE=PAPER

# Profil de configuration et sous-commande CLI lus par compose.yaml. PAPER par défaut ; LIVE n'est pas
# une valeur acceptable ici — son activation exige le manifeste d'approbation signé (§71).
OKXQ_CONFIG=configs/paper.yaml
OKXQ_MODE_CLI=paper

# Identifiant d'hôte journalisé (§61) pour distinguer deux processus du même rôle.
OKXQ_HOST_ID=remplacer-par-le-nom-de-hote
