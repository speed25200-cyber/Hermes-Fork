# ═══ gateway — LE SEUL service qui détient les clés OKX ═════════════════════════════════════════════
#
# OÙ POSER LE VRAI FICHIER : /opt/okxq/env/gateway.env sur le serveur, chmod 600, propriétaire root,
# hors du dépôt et hors de toute image. Il est posé soit par l'entrée « VPS status » du workflow
# .github/workflows/vps-status.yml (les valeurs arrivent par l'entrée standard, jamais en argument de
# commande, jamais journalisées), soit à la main sur le serveur.
#
# POURQUOI ICI ET NULLE PART AILLEURS (§60) : ce service est le seul à signer et à envoyer des ordres.
# Aucun autre conteneur — collecteur, stratégie, risque, worker JEV, API, interface — ne reçoit ces
# variables. Un secret injecté globalement dans tous les conteneurs viole cette séparation : le rayon
# d'un vol de clé serait alors égal à la surface complète de la plateforme.
#
# RÈGLES D'EXPLOITATION :
#   • ne jamais coller une clé dans une conversation, une issue, un commit ou un ticket ;
#   • restreindre la clé côté OKX : pas de droit de retrait, liste d'IP autorisées ;
#   • rotation et révocation testées avant LIVE (§60) ;
#   • LIVE reste désactivé : la présence d'une clé n'autorise rien à elle seule (§71).
#
# Les valeurs ci-dessous sont manifestement factices. Elles n'ont ni la forme ni la longueur d'un vrai
# identifiant : un copier-coller distrait échoue à l'authentification au lieu de signer par erreur.

OKX_API_KEY=remplacer-par-la-cle-reelle-hors-git
OKX_API_SECRET=remplacer-par-le-secret-reel-hors-git
OKX_API_PASSPHRASE=remplacer-par-la-passphrase-reelle-hors-git

# Profil de compte/région (métadonnée d'exécution, pas un secret) : détermine les domaines et les modes
# de compte autorisés (§45, §48).
OKX_ACCOUNT_REGION_PROFILE=remplacer-par-le-profil-de-compte

DATABASE_URL=postgresql+psycopg://okxq:remplacer-par-le-mot-de-passe-genere-hors-git@postgres:5432/okxq_paper

OKXQ_MODE=PAPER
OKXQ_CONFIG=configs/paper.yaml
OKXQ_MODE_CLI=paper
OKXQ_HOST_ID=remplacer-par-le-nom-de-hote

# Chemin du manifeste d'approbation signé exigé AVANT LIVE (§71). Sa simple présence n'active rien :
# le code vérifie la signature, le périmètre, la date et l'empreinte du code (§71). Laisser vide en
# PAPER.
OKXQ_LIVE_MANIFEST=
