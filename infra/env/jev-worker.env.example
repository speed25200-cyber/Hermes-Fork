# ═══ jev-worker — UNIQUEMENT sa propre clé TypeSafe ═════════════════════════════════════════════════
#
# OÙ POSER LE VRAI FICHIER : /opt/okxq/env/jev-worker.env sur le serveur (chmod 600), hors du dépôt.
#
# CE QUE CE SERVICE NE REÇOIT JAMAIS (§60, principe 10) :
#   • aucun identifiant d'échange (OKX_API_KEY / SECRET / PASSPHRASE) ;
#   • aucune clé opérateur (OPERATOR_AUTH_SECRET) ;
#   • aucune position, aucune équité, aucun patrimoine, aucune identité du titulaire ;
#   • aucune stratégie privée.
# Le conteneur ne monte d'ailleurs ni /app/data ni /app/artifacts (voir compose.yaml) : ni prix privés,
# ni modèles, ni rapports ne sont lisibles depuis ce processus. Il ne transforme que du TEXTE PUBLIC en
# variables sémantiques.

# Clé du fournisseur JEV / TypeSafe. Valeur manifestement factice : à remplacer sur le serveur.
TYPESAFE_API_KEY=remplacer-par-la-cle-typesafe-reelle-hors-git

# File d'attente durable des documents et cache des réponses (§50). Un rôle PostgreSQL aux droits
# MINIMAUX est recommandé (§60) : accès restreint aux tables de documents et de réponses JEV, sans
# lecture des positions, des ordres ni de la comptabilité.
DATABASE_URL=postgresql+psycopg://okxq_jev:remplacer-par-le-mot-de-passe-genere-hors-git@postgres:5432/okxq_paper

OKXQ_MODE=PAPER
OKXQ_CONFIG=configs/paper.yaml
OKXQ_MODE_CLI=paper
OKXQ_HOST_ID=remplacer-par-le-nom-de-hote

# Fichier d'état du worker lu par `okxq jev status` (volume okxq-runtime). Hors ligne, il rend
# `real_call: NOT_RUN` — un appel non exécuté n'est jamais présenté comme réussi.
OKXQ_JEV_STATUS_PATH=/app/runtime/jev_status.json
