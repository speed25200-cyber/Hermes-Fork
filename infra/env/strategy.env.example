# ═══ strategy — recherche et inférence ══════════════════════════════════════════════════════════════
#
# OÙ POSER LE VRAI FICHIER : /opt/okxq/env/strategy.env sur le serveur (chmod 600), hors du dépôt.
#
# CE SERVICE NE REÇOIT AUCUNE CLÉ OKX ET AUCUNE CLÉ TYPESAFE. Une sortie de modèle est une PROPOSITION :
# elle traverse le service de risque puis le gateway (§25, §41). L'absence de clé rend le contournement
# mécaniquement impossible, pas seulement interdit par convention.

DATABASE_URL=postgresql+psycopg://okxq:remplacer-par-le-mot-de-passe-genere-hors-git@postgres:5432/okxq_paper

OKXQ_MODE=PAPER
OKXQ_CONFIG=configs/paper.yaml
OKXQ_MODE_CLI=paper
OKXQ_HOST_ID=remplacer-par-le-nom-de-hote

# Empreinte du code déployé, journalisée avec chaque décision pour la reproductibilité (§12, §61).
# L'installateur peut y écrire le SHA du commit livré.
OKXQ_CODE_COMMIT=remplacer-par-le-sha-du-commit-deploye
