# ═══ api — clé opérateur, jamais les clés d'échange ═════════════════════════════════════════════════
#
# OÙ POSER LE VRAI FICHIER : /opt/okxq/env/api.env sur le serveur (chmod 600), hors du dépôt.
# deploy/install.sh génère la clé opérateur si elle est absente et ne l'imprime pas.
#
# CE SERVICE NE REÇOIT AUCUNE CLÉ OKX. L'interface DEMANDE des actions ; le gateway seul les signe.
# Un vol de la clé opérateur donne l'accès à la console, pas la capacité de signer un ordre chez OKX.

# Secret d'authentification de l'opérateur (§58). Les clés de rôle en sont dérivées. Générer une valeur
# aléatoire de 32 octets sur le serveur, par exemple `openssl rand -hex 32`, et ne jamais la coller
# ailleurs. La valeur ci-dessous est un texte de remplacement, pas un secret.
OPERATOR_AUTH_SECRET=remplacer-par-le-secret-operateur-genere-hors-git

DATABASE_URL=postgresql+psycopg://okxq:remplacer-par-le-mot-de-passe-genere-hors-git@postgres:5432/okxq_paper

OKXQ_MODE=PAPER
# Lu par `okxq.api.app:app_factory` (uvicorn n'a pas d'option --config).
OKXQ_CONFIG=configs/paper.yaml
OKXQ_HOST_ID=remplacer-par-le-nom-de-hote

# Canal d'alerte (§61) : vide = sink local. Ne pas annoncer une alerte envoyée sans canal testé.
ALERT_WEBHOOK_URL=
