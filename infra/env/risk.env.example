# ═══ risk — service de risque INDÉPENDANT ══════════════════════════════════════════════════════════
#
# OÙ POSER LE VRAI FICHIER : /opt/okxq/env/risk.env sur le serveur (chmod 600), hors du dépôt.
#
# CE SERVICE NE REÇOIT AUCUNE CLÉ OKX. Il détient l'autorité finale d'AUTORISATION (§25) ; il n'exécute
# rien. Séparer l'autorité de l'exécution n'a de sens que si le décideur ne peut pas exécuter lui-même.

DATABASE_URL=postgresql+psycopg://okxq:remplacer-par-le-mot-de-passe-genere-hors-git@postgres:5432/okxq_paper

OKXQ_MODE=PAPER
OKXQ_CONFIG=configs/paper.yaml
OKXQ_MODE_CLI=paper
OKXQ_HOST_ID=remplacer-par-le-nom-de-hote

# Canal d'alerte (§61). Un webhook local par défaut : ne pas prétendre qu'une alerte est envoyée sans
# canal réellement configuré et testé.
ALERT_WEBHOOK_URL=remplacer-ou-laisser-vide-pour-le-sink-local
