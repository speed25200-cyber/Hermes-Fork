  "rules": [
    {
      "definition": "-Z(cs_funding_sum_10080m): buy low settled seven-day funding and sell high funding",
      "name": "carry",
      "terms": [
        {
          "coefficient": -1.0,
          "feature": "cs_funding_sum_10080m",
          "scale": 1.0
        }
      ]
    },
    {
      "definition": "-Z(cs_premium): buy discounted perpetuals and sell expensive perpetuals",
      "name": "basis",
      "terms": [
        {
          "coefficient": -1.0,
          "feature": "cs_premium",
          "scale": 1.0
        }
      ]
    },
    {
      "definition": "-0.5*Z(iret_240m) - 0.5*Z(iret_1440m): fade four-hour and one-day residual moves",
      "name": "reversal",
      "terms": [
        {
          "coefficient": -0.5,
          "feature": "iret_240m",
          "scale": 1.0
        },
        {
          "coefficient": -0.5,
          "feature": "iret_1440m",
          "scale": 1.0
        }
      ]
    },
    {
      "definition": "Z(iret_10080m) - sqrt(1/7)*Z(iret_1440m): seven-day residual momentum excluding the last day",
      "name": "momentum",
      "terms": [
        {
          "coefficient": 1.0,
          "feature": "iret_10080m",
          "scale": 1.0
        },
        {
          "coefficient": -0.3779644730092272,
          "feature": "iret_1440m",
          "scale": 1.0
        }
      ]
    },
    {
      "definition": "Z(flow_ret_div; scale=0.1): follow relative aggressive flow not yet reflected in residual price",
      "name": "flow",
      "terms": [
        {
          "coefficient": 1.0,
          "feature": "flow_ret_div",
          "scale": 0.1
        }
      ]
    },
    {
      "definition": "Arithmetic mean of the five raw fixed rules; cross-sectional standardisation follows the sum",
      "name": "combined",
      "terms": [
        {
          "coefficient": -0.2,
          "feature": "cs_funding_sum_10080m",
          "scale": 1.0
        },
        {
          "coefficient": -0.2,
          "feature": "cs_premium",
          "scale": 1.0
        },
        {
          "coefficient": -0.1,
          "feature": "iret_240m",
